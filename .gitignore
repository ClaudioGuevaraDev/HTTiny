frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
bin/
build/bin/
.task/
.DS_Store

# Packaging output. build/appicon.png is the source and is committed; everything
# below is derived from it or downloaded at package time.
build/windows/icon.ico
build/darwin/icons.icns
build/darwin/Assets.car
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
build/linux/*.desktop
build/linux/appimage/
wails_windows_*.syso

# The updater signing key. build/updater.key.pub is committed and is the trust root;
# the private half never is — it lives in the UPDATER_PRIVATE_KEY secret.
updater.key
*.key
